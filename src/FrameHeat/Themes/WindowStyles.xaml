<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:core="clr-namespace:FrameHeat.Core.Settings;assembly=FrameHeat.Core"
                    xmlns:views="clr-namespace:FrameHeat.Views">

  <views:HexColorBrushConverter x:Key="HexColorBrush" />

  <!-- Column widths shared by the alert limit header and its rows. -->
  <GridLength x:Key="LimitNameColumn">100</GridLength>
  <GridLength x:Key="LimitValueColumn">56</GridLength>

  <!-- Columns of a settings row: the label, then the control, then for sliders the value. -->
  <GridLength x:Key="FormLabelColumn">170</GridLength>
  <GridLength x:Key="FormValueColumn">56</GridLength>

  <!-- Range of the alert limit sliders, in degrees. -->
  <sys:Double x:Key="LimitSliderMin">30</sys:Double>
  <sys:Double x:Key="LimitSliderMax">110</sys:Double>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,14,18,16" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <Style x:Key="DialogMessage" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Small explanation under a control. -->
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="Opacity" Value="0.65" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>

  <!-- Small explanation under a card title, before the controls it describes. -->
  <Style x:Key="Intro" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style x:Key="ColumnHeader" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="WarningHeader" TargetType="TextBlock" BasedOn="{StaticResource ColumnHeader}">
    <Setter Property="Foreground" Value="{Binding Appearance.WarningColor, Converter={StaticResource HexColorBrush}, ConverterParameter={x:Static core:AppearanceSettings.DefaultWarningColor}}" />
  </Style>

  <Style x:Key="CriticalHeader" TargetType="TextBlock" BasedOn="{StaticResource ColumnHeader}">
    <Setter Property="Foreground" Value="{Binding Appearance.CriticalColor, Converter={StaticResource HexColorBrush}, ConverterParameter={x:Static core:AppearanceSettings.DefaultCriticalColor}}" />
    <Setter Property="Margin" Value="10,0,0,0" />
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

  <Style x:Key="AccentSwatchList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A round color dot with a thin outline, so pale colors show on a light window. The selected one gets a ring in the text color. -->
  <Style x:Key="AccentSwatch" TargetType="ListBoxItem">
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Width="30" Height="30" Cursor="Hand">
            <Ellipse x:Name="Ring" StrokeThickness="2" Stroke="Transparent" />
            <Ellipse Margin="4" StrokeThickness="1" Fill="{Binding}"
                     Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
