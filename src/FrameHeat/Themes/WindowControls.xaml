<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:FrameHeat.Views">

  <!-- Implicit styles for the settings window and the message dialog. They extend the Fluent styles so the
       controls keep the Windows 11 look; merged into each window because the Fluent theme must already be loaded. -->
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <!-- Long translations wrap onto a second line instead of running past the card edge. -->
  <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- A click on the track puts the handle where the mouse is. Without this a click only moves it one
       large step, which on a slider such as the size jumps straight to the end. -->
  <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
  </Style>

  <!-- A settings row: the label on the left and one control beside it. -->
  <Style x:Key="FormRow" TargetType="HeaderedContentControl">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HeaderTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding}" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <Grid MinHeight="44">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{StaticResource FormLabelColumn}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The solid panel is always opaque, so its opacity slider has no effect there. -->
  <Style x:Key="OpacityRow" TargetType="views:SliderRow">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Appearance.PanelStyle}" Value="Solid">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- A button that shows a color. -->
  <Style x:Key="ColorButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="6" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- The rainbow disc after the color swatches: any other color. It is as big as a swatch, so it always fits on their
       row, whatever the language, and its tooltip names it. -->
  <Style x:Key="CustomColorButton" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Margin" Value="2,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Ellipse x:Name="Disc" Margin="4" StrokeThickness="1"
                     Stroke="{DynamicResource ControlStrokeColorDefaultBrush}">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#EF4444" Offset="0.00" />
                  <GradientStop Color="#F59E0B" Offset="0.20" />
                  <GradientStop Color="#EAB308" Offset="0.35" />
                  <GradientStop Color="#22C55E" Offset="0.50" />
                  <GradientStop Color="#06B6D4" Offset="0.65" />
                  <GradientStop Color="#3B82F6" Offset="0.80" />
                  <GradientStop Color="#A855F7" Offset="1.00" />
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="FocusRing" Margin="1" StrokeThickness="2" Visibility="Collapsed"
                     Stroke="{DynamicResource TextFillColorPrimaryBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Disc" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Disc" Property="Opacity" Value="0.65" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The small up and down buttons of the tile list. -->
  <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="MinWidth" Value="34" />
  </Style>

</ResourceDictionary>
