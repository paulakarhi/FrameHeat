<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:FrameHeat.Views"
                    xmlns:vm="clr-namespace:FrameHeat.ViewModels">

  <!-- Every font size below is a base size times the text scale of the widget. -->
  <views:ScaledFontSizeConverter x:Key="ScaledFontSize" />

  <Style x:Key="TileLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{Binding TextScale, Converter={StaticResource ScaledFontSize}, ConverterParameter=11}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="TileSecondary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{Binding TextScale, Converter={StaticResource ScaledFontSize}, ConverterParameter=11}" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="TileUnit" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{Binding TextScale, Converter={StaticResource ScaledFontSize}, ConverterParameter=10}" />
    <Setter Property="Foreground" Value="{StaticResource TextUnitBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,-4,0,0" />
  </Style>

  <!-- Small lines under the value, for example the one percent low of a frame rate. -->
  <Style x:Key="TileExtra" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{Binding TextScale, Converter={StaticResource ScaledFontSize}, ConverterParameter=11}" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <Style x:Key="GaugeValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{Binding TextScale, Converter={StaticResource ScaledFontSize}, ConverterParameter=24}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style x:Key="CompactValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{Binding TextScale, Converter={StaticResource ScaledFontSize}, ConverterParameter=28}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <!-- The value in the one-line design. -->
  <Style x:Key="RowValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{Binding TextScale, Converter={StaticResource ScaledFontSize}, ConverterParameter=16}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Corner radius and margin come from the shape settings, so the tile sets them itself. -->
  <Style x:Key="TileCard" TargetType="Border">
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- The unit after the number in the compact designs. -->
  <Style x:Key="CompactUnit" TargetType="Run">
    <Setter Property="FontSize" Value="{Binding TextScale, Converter={StaticResource ScaledFontSize}, ConverterParameter=13}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource TextUnitBrush}" />
  </Style>

  <Style x:Key="ToolbarHint" TargetType="TextBlock" BasedOn="{StaticResource TileLabel}">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="200" />
  </Style>

  <Style x:Key="UsageBar" TargetType="Border">
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style x:Key="TileIcon" TargetType="Path">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The alert tint fades in and out while the tile is critical. -->
  <Style x:Key="PulseWhenCritical" TargetType="Border">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Severity}" Value="Critical">
        <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="PulseStoryboard">
            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.7" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="PulseStoryboard" />
        </DataTrigger.ExitActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Background and border are style setters, not local values, so the editing trigger can override them. -->
  <Style x:Key="OverlayPanel" TargetType="Border">
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="{Binding Shape.Panel}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{Binding PanelBackground}" />
    <Setter Property="BorderBrush" Value="{Binding PanelOutline}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding EditMode}" Value="True">
        <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="VisibleWhenEditing" TargetType="Border">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding EditMode}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="HiddenWhenPopulated" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="10,8" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding HasMetrics}" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- The stock button looks dated on a dark translucent panel, so the toolbar draws its own. -->
  <Style x:Key="ToolbarButton" TargetType="Button">
    <Setter Property="Foreground" Value="{x:Static vm:Palette.Text}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,3,0,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" CornerRadius="8" Padding="12,6" BorderThickness="1"
                  Background="{StaticResource ToolbarButtonBrush}" BorderBrush="{StaticResource ToolbarBorderBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{StaticResource ToolbarButtonHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{StaticResource ToolbarButtonPressedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
