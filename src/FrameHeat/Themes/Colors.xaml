<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Widget text -->
  <SolidColorBrush x:Key="TextSoftBrush" Color="#B4C0CF" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA7B8" />
  <SolidColorBrush x:Key="TextUnitBrush" Color="#AAB6C6" />

  <!-- Widget surfaces -->
  <SolidColorBrush x:Key="TrackBrush" Color="#22FFFFFF" />
  <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F2141A24" />
  <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ToolbarButtonBrush" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="ToolbarButtonHoverBrush" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ToolbarButtonPressedBrush" Color="#59FFFFFF" />

  <!-- Settings cards: translucent grey reads well on both light and dark themes -->
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="#10808080" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#26808080" />

</ResourceDictionary>
