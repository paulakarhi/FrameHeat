<UserControl x:Class="FrameHeat.Views.MetricTile"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FrameHeat.Views">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:FractionToWidthConverter x:Key="FractionToWidth" />

    <!-- The icon and name of the device, shown in every design. -->
    <DataTemplate x:Key="TileTitle">
      <StackPanel Orientation="Horizontal">
        <Path Style="{StaticResource TileIcon}" Data="{Binding IconData}" />
        <TextBlock Style="{StaticResource TileLabel}" Margin="6,0,0,0" Text="{Binding Label}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Border Style="{StaticResource TileCard}" Background="{Binding TileBackground}" BorderBrush="{Binding TileOutline}"
          CornerRadius="{Binding Shape.Tile}" Margin="{Binding Shape.Margin}">
    <Grid>
      <Border CornerRadius="{Binding Shape.Inner}" Background="{Binding Tint}" Style="{StaticResource PulseWhenCritical}" />

      <!-- Ring and compact designs -->
      <StackPanel Margin="12,10,12,12" MinWidth="76" Visibility="{Binding IsCardDesign, Converter={StaticResource BoolToVisibility}}">
        <!-- A long name widens the tile instead of running into the usage figure. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TileTitle}"
                          Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Grid.Column="1" Style="{StaticResource TileSecondary}" Margin="10,0,0,0" HorizontalAlignment="Right"
                     Text="{Binding SecondaryText}"
                     Visibility="{Binding ShowSecondary, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <Grid Width="70" Height="70" Margin="0,8,0,2"
              Visibility="{Binding IsGauge, Converter={StaticResource BoolToVisibility}}">
          <views:ArcGauge Fraction="{Binding GaugeFraction}" ValueBrush="{Binding GaugeBrush}"
                          TrackBrush="{StaticResource TrackBrush}" Thickness="6" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- A big number shrinks to stay inside the ring. -->
            <Viewbox MaxWidth="52" StretchDirection="DownOnly">
              <TextBlock Style="{StaticResource GaugeValue}" Text="{Binding PrimaryText}" Foreground="{Binding PrimaryBrush}" />
            </Viewbox>
            <TextBlock Style="{StaticResource TileUnit}" Text="{Binding PrimaryUnit}" />
          </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource CompactValue}" Foreground="{Binding PrimaryBrush}"
                   Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}}">
          <Run Text="{Binding PrimaryText, Mode=OneWay}" /><Run Style="{StaticResource CompactUnit}" Text="{Binding PrimaryUnit, Mode=OneWay}" />
        </TextBlock>

        <TextBlock Style="{StaticResource TileExtra}" Text="{Binding ExtraText}"
                   Visibility="{Binding ShowExtra, Converter={StaticResource BoolToVisibility}}" />

        <Grid Height="4" Margin="0,8,0,0" Visibility="{Binding ShowBar, Converter={StaticResource BoolToVisibility}}">
          <Border x:Name="Track" Style="{StaticResource UsageBar}" Background="{StaticResource TrackBrush}" />
          <Border Style="{StaticResource UsageBar}" HorizontalAlignment="Left" Background="{Binding UsageBrush}">
            <Border.Width>
              <MultiBinding Converter="{StaticResource FractionToWidth}">
                <Binding Path="UsageFraction" />
                <Binding Path="ActualWidth" ElementName="Track" />
              </MultiBinding>
            </Border.Width>
          </Border>
        </Grid>
      </StackPanel>

      <!-- One-line design: name, value and unit. -->
      <StackPanel Orientation="Horizontal" Margin="10,6" Visibility="{Binding IsTextRow, Converter={StaticResource BoolToVisibility}}">
        <ContentControl Margin="0,0,10,0" Content="{Binding}" ContentTemplate="{StaticResource TileTitle}"
                        Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Style="{StaticResource RowValue}" Foreground="{Binding PrimaryBrush}">
          <Run Text="{Binding PrimaryText, Mode=OneWay}" /><Run Style="{StaticResource CompactUnit}" Text="{Binding PrimaryUnit, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Style="{StaticResource TileSecondary}" Margin="10,0,0,0" Text="{Binding SecondaryText}"
                   Visibility="{Binding ShowSecondary, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
