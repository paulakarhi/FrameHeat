<UserControl x:Class="FrameHeat.Views.SliderRow"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Row">

  <!-- A label, a slider and its current value, in the same columns as the other rows of a settings card. -->
  <Grid MinHeight="44">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{StaticResource FormLabelColumn}" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="{StaticResource FormValueColumn}" />
    </Grid.ColumnDefinitions>

    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label, ElementName=Row}" />
    <Slider Grid.Column="1" IsSnapToTickEnabled="True"
            Minimum="{Binding Minimum, ElementName=Row}" Maximum="{Binding Maximum, ElementName=Row}"
            TickFrequency="{Binding TickFrequency, ElementName=Row}" Value="{Binding Value, ElementName=Row, Mode=TwoWay}" />
    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" TextWrapping="NoWrap" Margin="0"
               Text="{Binding ValueText, ElementName=Row}" />
  </Grid>
</UserControl>
