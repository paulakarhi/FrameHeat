<UserControl x:Class="FrameHeat.Views.AlertLimitRow"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FrameHeat.Views">

  <UserControl.Resources>
    <views:TemperatureTextConverter x:Key="TemperatureText" />
  </UserControl.Resources>

  <!-- DataContext is the AlertLimits object for this row. The shared column widths line up with the header in the settings window. -->
  <Grid Height="34">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{StaticResource LimitNameColumn}" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="{StaticResource LimitValueColumn}" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="{StaticResource LimitValueColumn}" />
    </Grid.ColumnDefinitions>

    <TextBlock Style="{StaticResource FieldLabel}"
               Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}" />

    <Slider Grid.Column="1" TickFrequency="1" IsSnapToTickEnabled="True"
            Minimum="{StaticResource LimitSliderMin}" Maximum="{StaticResource LimitSliderMax}"
            Value="{Binding Warning}" />
    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" TextWrapping="NoWrap" Margin="0">
      <TextBlock.Text>
        <MultiBinding Converter="{StaticResource TemperatureText}">
          <Binding Path="Warning" />
          <Binding Path="DataContext.Appearance.TemperatureUnit" RelativeSource="{RelativeSource AncestorType=Window}" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>

    <Slider Grid.Column="3" Margin="10,0,0,0" TickFrequency="1" IsSnapToTickEnabled="True"
            Minimum="{StaticResource LimitSliderMin}" Maximum="{StaticResource LimitSliderMax}"
            Value="{Binding Critical}" />
    <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" TextWrapping="NoWrap" Margin="0">
      <TextBlock.Text>
        <MultiBinding Converter="{StaticResource TemperatureText}">
          <Binding Path="Critical" />
          <Binding Path="DataContext.Appearance.TemperatureUnit" RelativeSource="{RelativeSource AncestorType=Window}" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
  </Grid>
</UserControl>
