<Window x:Class="FrameHeat.Views.OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FrameHeat.Views"
        xmlns:markup="clr-namespace:FrameHeat.Markup"
        Title="FrameHeat"
        ThemeMode="None"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="{Binding AlwaysOnTop}"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Grayscale"
        Opacity="{Binding WidgetOpacity}"
        FontFamily="Segoe UI Variable Display, Segoe UI">

  <Border Style="{StaticResource OverlayPanel}">
    <Border.LayoutTransform>
      <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
    </Border.LayoutTransform>

    <StackPanel>
      <ItemsControl ItemsSource="{Binding Metrics}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="{Binding DataContext.Orientation, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <views:MetricTile />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Style="{StaticResource HiddenWhenPopulated}" Text="{markup:T overlay_searching}" />

      <views:EditToolbar />
    </StackPanel>
  </Border>
</Window>
